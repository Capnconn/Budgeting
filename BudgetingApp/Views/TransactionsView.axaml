<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="45"
             xmlns:vm="using:BudgetingApp.ViewModels"
             x:Class="BudgetingApp.Views.TransactionsView"
             x:DataType="vm:TransactionsViewModel">

    <DockPanel Background="#F7F7FA">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E8E8ED"
                BorderThickness="0 0 0 1"
                Padding="28 20">
            <Grid ColumnDefinitions="* Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Transactions"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E" />
                    <TextBlock Text="{Binding TransactionCount, StringFormat='{}{0} transactions'}"
                               FontSize="13"
                               Foreground="#9090A0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column Headers -->
        <Border DockPanel.Dock="Top"
                Background="#F7F7FA"
                Padding="28 10">
            <Grid ColumnDefinitions="* 140 110">
                <TextBlock Grid.Column="0" Text="DESCRIPTION"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9090A0" LetterSpacing="1" />
                <TextBlock Grid.Column="1" Text="DATE"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9090A0" LetterSpacing="1" />
                <TextBlock Grid.Column="2" Text="AMOUNT"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#9090A0" LetterSpacing="1"
                           TextAlignment="Right" />
            </Grid>
        </Border>

        <!-- Transaction List -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Transactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                Margin="16 3 16 0"
                                CornerRadius="8"
                                Padding="20 14">
                            <Grid ColumnDefinitions="Auto * 140 110">

                                <!-- Category Icon -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="10"
                                        Background="{Binding CategoryColor}"
                                        Margin="0 0 14 0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryIcon}"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Description + Category -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="#1A1A2E" />
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="12"
                                               Foreground="#9090A0" />
                                </StackPanel>

                                <!-- Date -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Date, StringFormat='{}{0:MMM dd, yyyy}'}"
                                           FontSize="13"
                                           Foreground="#6B6B80"
                                           VerticalAlignment="Center" />

                                <!-- Amount -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding FormattedAmount}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AmountColor}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>