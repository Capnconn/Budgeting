<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:FluentAvalonia.UI.Controls"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BudgetingApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="BudgetingApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="AttachedToVisualTree">
            <ia:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid RowDefinitions="Auto,*">
        <controls:FANavigationView AlwaysShowHeader="False"
                                   WindowDecorationProperties.ElementRole="User"
                                   PaneDisplayMode="Left"
                                   Name="NavView"
                                   IsSettingsVisible="False">
            <controls:FAFrame Name="FrameView" />
        </controls:FANavigationView>
    </Grid>
</UserControl>
